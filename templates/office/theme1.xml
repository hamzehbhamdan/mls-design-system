<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<a:theme xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" name="MLS Design System">
  <a:themeElements>
    <a:clrScheme name="MLS">
      <a:dk1><a:srgbClr val="0B0F16"/></a:dk1>
      <a:lt1><a:srgbClr val="FFFFFF"/></a:lt1>
      <a:dk2><a:srgbClr val="001F5B"/></a:dk2>
      <a:lt2><a:srgbClr val="F2F4F8"/></a:lt2>
      <a:accent1><a:srgbClr val="1844B9"/></a:accent1>
      <a:accent2><a:srgbClr val="E77412"/></a:accent2>
      <a:accent3><a:srgbClr val="07A4A4"/></a:accent3>
      <a:accent4><a:srgbClr val="AC0311"/></a:accent4>
      <a:accent5><a:srgbClr val="BC70EE"/></a:accent5>
      <a:accent6><a:srgbClr val="03A14A"/></a:accent6>
      <a:hlink><a:srgbClr val="194EAD"/></a:hlink>
      <a:folHlink><a:srgbClr val="BC70EE"/></a:folHlink>
    </a:clrScheme>
    <a:fontScheme name="MLS">
      <a:majorFont><a:latin typeface="Arial"/><a:ea typeface=""/><a:cs typeface=""/></a:majorFont>
      <a:minorFont><a:latin typeface="Arial"/><a:ea typeface=""/><a:cs typeface=""/></a:minorFont>
    </a:fontScheme>
    <a:fmtScheme name="MLS">
      <a:fillStyleLst>
        <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
        <a:solidFill><a:schemeClr val="phClr"><a:tint val="88000"/></a:schemeClr></a:solidFill>
        <a:solidFill><a:schemeClr val="phClr"><a:shade val="88000"/></a:schemeClr></a:solidFill>
      </a:fillStyleLst>
      <a:lnStyleLst>
        <a:ln w="9525" cap="flat" cmpd="sng" algn="ctr"><a:solidFill><a:schemeClr val="phClr"/></a:solidFill><a:prstDash val="solid"/></a:ln>
        <a:ln w="19050" cap="flat" cmpd="sng" algn="ctr"><a:solidFill><a:schemeClr val="phClr"/></a:solidFill><a:prstDash val="solid"/></a:ln>
        <a:ln w="28575" cap="flat" cmpd="sng" algn="ctr"><a:solidFill><a:schemeClr val="phClr"/></a:solidFill><a:prstDash val="solid"/></a:ln>
      </a:lnStyleLst>
      <!-- No shadows, no glows. MLS's own guidelines prohibit effects on the
           crest, and an effect list here would let every shape in Office
           inherit one. -->
      <a:effectStyleLst>
        <a:effectStyle><a:effectLst/></a:effectStyle>
        <a:effectStyle><a:effectLst/></a:effectStyle>
        <a:effectStyle><a:effectLst/></a:effectStyle>
      </a:effectStyleLst>
      <a:bgFillStyleLst>
        <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
        <a:solidFill><a:schemeClr val="phClr"><a:tint val="95000"/></a:schemeClr></a:solidFill>
        <a:solidFill><a:schemeClr val="phClr"><a:shade val="95000"/></a:schemeClr></a:solidFill>
      </a:bgFillStyleLst>
    </a:fmtScheme>
  </a:themeElements>
  <a:objectDefaults/>
  <a:extraClrSchemeLst/>
</a:theme>
